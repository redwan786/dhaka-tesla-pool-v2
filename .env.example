# Application
NODE_ENV=development
# Hosting providers normally inject PORT. Local development uses API_PORT.
# PORT=
API_PORT=4000
# Comma-separate exact origins when more than one frontend is allowed.
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Browser build-time value; include the /api suffix.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Supabase PostgreSQL
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Backend-only authentication secret (minimum 24 characters)
JWT_SECRET=replace-with-a-long-random-secret
