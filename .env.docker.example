# Optional Docker Compose overrides. Defaults already work for local evaluation.
DOCKER_POSTGRES_DB=dhaka_tesla_pool
DOCKER_POSTGRES_USER=postgres
DOCKER_POSTGRES_PASSWORD=replace-with-a-local-docker-password
DOCKER_POSTGRES_PORT=5432
DOCKER_API_PORT=4000
DOCKER_WEB_PORT=3000
DOCKER_JWT_SECRET=replace-with-at-least-24-random-characters
# For a VM opened from the host browser, replace VM_IP with `hostname -I`.
DOCKER_WEB_ORIGIN=http://VM_IP:3000
DOCKER_PUBLIC_API_URL=http://VM_IP:4000/api
