# Use a dedicated test database when possible. You may explicitly use the same
# migrated Supabase database; tests touch only isolated itest-* accounts.
TEST_DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:5432/postgres?sslmode=require
TEST_DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
